# Copy to .env.local and adjust. Vite only exposes VITE_-prefixed variables,
# and everything it exposes is baked into the public bundle — never put a secret
# here.
#
# Where the Laravel API lives. Defaults to the local dev server when unset, so
# a production build MUST set this or it will try to call the developer's
# machine.
VITE_API_URL=http://127.0.0.1:8000/api
